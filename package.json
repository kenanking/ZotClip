{
  "name": "zotclip",
  "type": "module",
  "version": "0.5.0",
  "description": "Copy Zotero attachment files to clipboard and generate tags using AI providers (DeepSeek, OpenRouter, Ollama, LM Studio, Custom).",
  "config": {
    "addonName": "ZotClip",
    "addonID": "zotclip@cvrsg.dev",
    "addonRef": "zotclip",
    "addonInstance": "ZotClip",
    "prefsPrefix": "extensions.zotero.zotclip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenanking/ZotClip.git"
  },
  "author": "Yan Tang",
  "bugs": {
    "url": "https://github.com/kenanking/ZotClip/issues"
  },
  "homepage": "https://github.com/kenanking/ZotClip#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test --no-watch",
    "update-deps": "npm update --save",
    "test:unit": "tsx --test --experimental-test-coverage spec/unit/**/*.test.ts"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "eslint": "^10.10.0",
    "mocha": "^12.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "zotero-plugin-scaffold": "^0.9.1",
    "zotero-types": "4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
